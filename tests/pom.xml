<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>org.weasis</groupId>
    <artifactId>weasis-framework</artifactId>
    <!--suppress MavenPropertyInParent -->
    <version>${revision}${changelist}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <artifactId>tests</artifactId>
  <name>Tests</name>
  <!-- jar, not pom: the smoke suite below is a surefire test, which a pom module never runs -->
  <packaging>jar</packaging>
  <description>Aggregated coverage and the scripted smoke suite: the scripts of smoke/ run through
    weasis-cli against a Weasis started from the local Maven repository, on synthetic DICOM data,
    when -Dweasis.smoke=true (under Xvfb on a server)</description>
  <properties>
    <weasis.smoke>false</weasis.smoke>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <weasis.smoke>${weasis.smoke}</weasis.smoke>
            <weasis.smoke.repo>${settings.localRepository}</weasis.smoke.repo>
            <weasis.smoke.root>${project.basedir}</weasis.smoke.root>
            <weasis.smoke.version>${project.version}</weasis.smoke.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.class</exclude>
            <exclude>**/module-info.class</exclude>
            <exclude>**/Messages.class</exclude>
            <!-- Exclude weasis-dicom-tools library-->
            <exclude>org/weasis/dicom/mf/**</exclude>
            <exclude>org/weasis/dicom/op/**</exclude>
            <exclude>org/weasis/dicom/param/**</exclude>
            <exclude>org/weasis/dicom/tool/**</exclude>
            <exclude>org/weasis/dicom/util/**</exclude>
            <exclude>org/weasis/dicom/web/**</exclude>
            <!-- Exclude weasis-core-img library-->
            <exclude>org/weasis/core/util/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>report</id>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.weasis.launcher</groupId>
      <artifactId>weasis-launcher</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.weasis.acquire</groupId>
      <artifactId>weasis-acquire-explorer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.weasis.dicom</groupId>
      <artifactId>weasis-dicom-codec</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.weasis.core</groupId>
      <artifactId>weasis-core</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
