# 03 — a batch that leaves no trace: checkpoint, change the display, roll back, prove it.

$cp = state:checkpoint --label "smoke transaction"
@expect ${cp.taken} == true

$open = dicom:open --series ${mr} --wait
view2d:rotate --view ${open.target.view} --degrees 90
$line = view2d:measure --view ${open.target.view} --type line --points 10,10,30,30

$during = state:diff --from ${cp.checkpoint}
@expect ${during.diff.empty} == false

$back = state:rollback --to ${cp.checkpoint} --close-new
@expect ${back.restored} == true

$after = state:diff --from ${cp.checkpoint}
@expect ${after.diff.empty} == true
