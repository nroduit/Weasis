# windows-screens.weasis — screens by role, a viewer in its own window, fullscreen, a tool as a tab, a layout kept and restored.
# Run it with: weasis-cli script:run --file windows-screens.weasis --set data=<folder of one study> --set out=<folder> --report <file.xml>
# On a one-monitor station every role resolves to the same screen; the roles are still listed.

$cp = state:checkpoint --label "scenario windows-screens"
@expect ${cp.taken} == true
$load = dicom:load --path "${data}" --wait
@expect ${load.loaded} == true
@wait dicom:study.opened --timeout 60
$ws = workspace:list
@expect ${ws.selected} == ${event.view}

# S1: the screens of the workstation by role; the control screen is the one of the main window
$screens = workspace:screens
@expect ${screens.screens[role=control].main} == true
@expect ${screens.screens[role=control].fulfilled} == true

# S2: the viewer in its own window
$win = workspace:detach --view ${ws.selected}
@expect ${win.windows[0].main} == false
@expect ${win.selected} == ${ws.selected}

# S4: fullscreen and back
$full = workspace:fullscreen --view ${ws.selected}
@expect ${full.selected} == ${ws.selected}
$normal = workspace:fullscreen --view ${ws.selected} --off
@expect ${normal.selected} == ${ws.selected}

# S5: the first tool of the tools side as a tab of the workspace, then back in its slot
$panel = workspace:panel
@expect ${panel.tools.collapsed} == false
$tab = workspace:panel --side TOOLS --tool ${panel.tools.slots[0]} --as-view
@expect ${tab.tools.views[0]} == ${panel.tools.slots[0]}
$slot = workspace:panel --side TOOLS --slot TOP --tool ${panel.tools.slots[0]}
@expect ${slot.tools.slots[0]} == ${panel.tools.slots[0]}

# S6: the layout kept to a file and restored, and the display kept as a session
$saved = workspace:save --out ${out}/windows-${cp.seq}.json
$loaded = workspace:load --file ${saved.file}
@expect ${loaded.selected} == ${ws.selected}
$keep = state:keep --label "scenario ${cp.seq}"
@expect ${keep.kept} == true
$restore = state:restore --session ${keep.session}
@expect ${restore.restored} == true
$delete = state:delete --session ${keep.session}
@expect ${delete.deleted} == true

$back = state:rollback --to ${cp.checkpoint} --close-new
@expect ${back.restored} == true
$after = state:diff --from ${cp.checkpoint}
@expect ${after.diff.empty} == true
