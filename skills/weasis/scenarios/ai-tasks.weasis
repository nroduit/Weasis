# ai-tasks.weasis — AI tasks as UPS-RS workitems: the servers, a task created on a study, listed as waiting, never created twice, canceled.
# The study must be loaded from a DICOMweb server that is enabled with "Create tasks" on the page
# DICOM > AI Tasks of the preferences. Read its uid with dicom:list, then:
#   weasis-cli script:run --file ai-tasks.weasis --set study=<study uid> --set code=<task code> --set scheme=<coding scheme> --report <file.xml>
# Take a code that no performer of the server takes (a test code of yours, scheme 99SITE for
# example) and a study without a task waiting: the task then stays queued while the script reads
# it, and the script cancels it. It leaves one canceled workitem on the server and starts no
# analysis. The run of a real task and the opening of its results are in the scenario sheet.

$cp = state:checkpoint --label "scenario ai-tasks"
@expect ${cp.taken} == true

# S1: the servers that take tasks, as the preference page wrote them
$nodes = ups:nodes
@expect ${nodes.nodes[0].id} matches .+

# S2: the tasks of the study as the server lists them
$before = ups:search --study ${study}
@expect ${before.study} == ${study}

# S2: a task asked on the whole study
$run = ups:run --study ${study} --code ${code} --scheme ${scheme}
@expect ${run.study} == ${study}
@expect ${run.code} == ${code}
@expect ${run.workitem} matches [0-9.]+

# S2: it is listed, waiting
$listed = ups:search --study ${study}
@expect ${listed.workitems[state=SCHEDULED].workitem} == ${run.workitem}

# S2: asked again while it waits, the same task comes back and no second one is created
$again = ups:run --study ${study} --code ${code} --scheme ${scheme}
@expect ${again.workitem} == ${run.workitem}

# S4: a task that did not run names no result
$outputs = ups:outputs --study ${study} --workitem ${run.workitem}
@expect ${outputs.workitem} == ${run.workitem}

# S3: the cancellation of the queued task, with its reason
$cancel = ups:cancel --study ${study} --workitem ${run.workitem} --reason "Weasis preview scenario"
@expect ${cancel.canceled} == true

# S3: the watcher answers, by the notification channel of the server or by reading the tasks
$watch = ups:watch --study ${study} --timeout 10
@expect ${watch.study} == ${study}

$back = state:rollback --to ${cp.checkpoint} --close-new
@expect ${back.restored} == true
$after = state:diff --from ${cp.checkpoint}
@expect ${after.diff.empty} == true
