# commands.weasis — the command surface: the instance, a transaction and its rollback, the events, the feedback link.
# Run it with: weasis-cli script:run --file commands.weasis --set data=<folder of one study> --set out=<folder> --report <file.xml>

# S1: the instance and its command API
$info = weasis:info
@expect ${info.commandApiVersion} matches 2\..*
@expect ${info.preview} == true

# S3: a checkpoint, changes, the diff that lists them
$cp = state:checkpoint --label "scenario commands"
@expect ${cp.taken} == true
$load = dicom:load --path "${data}" --wait
@expect ${load.loaded} == true
$list = dicom:list
$open = dicom:open --series ${list.patients[0].studies[0].series[0].id} --wait
$rotate = view2d:rotate --view ${open.target.view} --degrees 90
@expect ${rotate.rotation} == 90
$line = view2d:measure --view ${open.target.view} --type line --points 20,20,120,20
@expect ${line.layer.name} == AI
$during = state:diff --from ${cp.checkpoint}
@expect ${during.diff.empty} == false
$checkpoints = state:checkpoints
@expect ${checkpoints.checkpoints[0].checkpoint} == ${cp.checkpoint}

# S5.4: the events the batch left, with their origin
$events = events:recent --last 5 --filter command:finished
@expect ${events.events[0].origin} == remote
@expect ${events.lastSeq} > ${cp.seq}

# the feedback channel of the preview
$feedback = weasis:feedback
@expect ${feedback.url} matches https://github\.com/.*
@expect ${feedback.preview} == true

# S3.3: a dry run, the rollback, the proof
$dry = state:rollback --to ${cp.checkpoint} --dry-run
@expect ${dry.dryRun} == true
@expect ${dry.diff.empty} == false
$back = state:rollback --to ${cp.checkpoint} --close-new
@expect ${back.restored} == true
$after = state:diff --from ${cp.checkpoint}
@expect ${after.diff.empty} == true
