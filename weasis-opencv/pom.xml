<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>weasis-parent</artifactId>
    <groupId>org.weasis</groupId>
    <!--suppress MavenPropertyInParent -->
    <version>${revision}${changelist}</version>
    <relativePath>../weasis-parent/pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <groupId>org.weasis.opencv</groupId>
  <artifactId>weasis-opencv</artifactId>
  <name>OpenCV plugins [${project.artifactId}]</name>
  <packaging>pom</packaging>

  <modules>
    <module>weasis-opencv-core-linux-aarch64</module>
    <module>weasis-opencv-core-linux-x86-64</module>
    <module>weasis-opencv-core-macosx-aarch64</module>
    <module>weasis-opencv-core-macosx-x86-64</module>
    <module>weasis-opencv-core-windows-x86-64</module>
  </modules>

  <properties>
    <native.folder>natives</native.folder>
    <native.files>changeMeInChildModule</native.files>
    <!-- Bind the OpenCV package version to the CI-friendly ${sha1} placeholder so that
         child modules can use it inside <version> without triggering the Maven warning
         "'version' contains an expression but should be a constant".
         The single source of truth remains weasis.opencv.pkg.version in weasis-parent/pom.xml. -->
    <sha1>${weasis.opencv.pkg.version}</sha1>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Plugin-Class>org.weasis.opencv.NativeLoaderPlugin</Plugin-Class>
              <Plugin-Native-Folder>${native.folder}</Plugin-Native-Folder>
              <Plugin-Native-Files>${native.files}</Plugin-Native-Files>
              <Plugin-Id>${project.artifactId}</Plugin-Id>
              <Plugin-Version>${weasis.opencv.native.version}</Plugin-Version>
              <Plugin-Provider>OpenCV Community</Plugin-Provider>
              <Plugin-Description>${project.name}</Plugin-Description>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.weasis.launcher</groupId>
      <artifactId>weasis-launcher</artifactId>
      <version>${project.parent.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
