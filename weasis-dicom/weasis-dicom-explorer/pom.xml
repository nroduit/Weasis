<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>weasis-dicom-parent</artifactId>
    <groupId>org.weasis.dicom</groupId>
    <!--suppress MavenPropertyInParent -->
    <version>${revision}${changelist}</version>
    <relativePath>../weasis-dicom-parent/pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <artifactId>weasis-dicom-explorer</artifactId>
  <packaging>jar</packaging>
  <name>DICOM - Data explorer [${project.artifactId}]</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Plugin-Class>org.weasis.dicom.explorer.internal.Activator</Plugin-Class>
              <Plugin-Dependencies>weasis-dicom-codec</Plugin-Dependencies>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.weasis.thirdparty</groupId>
      <artifactId>jaxb-osgi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.weasis.dicom</groupId>
      <artifactId>weasis-dicom-codec</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.lingala.zip4j</groupId>
      <artifactId>zip4j</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Only for tests loading DicomMediaUtils: at runtime joml is resolved from its own bundle -->
    <dependency>
      <groupId>org.joml</groupId>
      <artifactId>joml</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Only for tests reaching NetworkFileSystems: at runtime oshi is a common library (weasis.plugins.11) -->
    <dependency>
      <groupId>com.github.oshi</groupId>
      <artifactId>oshi-core-ffm</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
