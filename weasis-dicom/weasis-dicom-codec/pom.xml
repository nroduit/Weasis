<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>weasis-dicom-parent</artifactId>
    <groupId>org.weasis.dicom</groupId>
    <!--suppress MavenPropertyInParent -->
    <version>${revision}${changelist}</version>
    <relativePath>../weasis-dicom-parent/pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <artifactId>weasis-dicom-codec</artifactId>
  <name>DICOM - Codecs and parsers for DICOM [${project.artifactId}]</name>
  <packaging>jar</packaging>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>dcm4che</id>
      <name>dcm4che Repository</name>
      <url>https://www.dcm4che.org/maven2</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <filters>
                <!-- Include only the two xml files from the dcm4che-dict artifact -->
                <filter>
                  <artifact>org.dcm4che:dcm4che-dict</artifact>
                  <includes>
                    <include>uids.xml</include>
                    <include>dataelements.xml</include>
                  </includes>
                </filter>
                <!-- Keep previous global filter for signatures -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- preserve SPI/service files so PF4J plugin discovery works -->
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Plugin-Class>org.weasis.dicom.codec.internal.Activator</Plugin-Class>
              <Plugin-Dependencies>weasis-imageio-codec</Plugin-Dependencies>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.weasis</groupId>
      <artifactId>weasis-dicom-tools</artifactId>
      <version>${weasis-dicom-tools.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.weasis.core</groupId>
          <artifactId>weasis-core-img</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.weasis.thirdparty.org.opencv</groupId>
          <artifactId>libopencv_java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.weasis.thirdparty.org.opencv</groupId>
          <artifactId>opencv_java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Add dependency for loading JsonProvider with dcm4che-json -->
    <dependency>
      <groupId>org.glassfish.hk2</groupId>
      <artifactId>osgi-resource-locator</artifactId>
      <version>${osgi.resource.locator.version}</version>
    </dependency>

    <dependency>
      <groupId>org.weasis.imageio</groupId>
      <artifactId>weasis-imageio-codec</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.joml</groupId>
      <artifactId>joml</artifactId>
    </dependency>
  </dependencies>
</project>
