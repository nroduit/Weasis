<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <groupId>org.weasis.thirdparty.org.jogamp</groupId>
    <artifactId>jogamp-native</artifactId>
    <!--suppress MavenPropertyInParent -->
    <version>${revision}${changelist}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <packaging>jar</packaging>
  <artifactId>jogamp-linux-x86-64</artifactId>
  <name>JOGL - Linux x86-64 [${project.artifactId}]</name>
  <version>${sha1}</version>
  <properties>
    <native.folder>natives/linux-amd64</native.folder>
    <native.files>
      libgluegen_rt.so,
      libjocl.so,
      libnativewindow_awt.so,
      libnewt_drm.so,
      libnativewindow_x11.so,
      libnativewindow_drm.so,
      libnewt_head.so,
      libjogl_mobile.so,
      libjogl_desktop.so
    </native.files>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>

        <executions>
          <execution>
            <id>copy-dependency</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.jogamp.gluegen</groupId>
                  <artifactId>gluegen-rt</artifactId>
                  <version>${jogamp.version}</version>
                  <classifier>natives-linux-amd64</classifier>
                  <outputDirectory>target/classes</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>org.jogamp.jogl</groupId>
                  <artifactId>jogl-all</artifactId>
                  <version>${jogamp.version}</version>
                  <classifier>natives-linux-amd64</classifier>
                  <outputDirectory>target/classes</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>org.jogamp.jocl</groupId>
                  <artifactId>jocl</artifactId>
                  <version>${jogamp.version}</version>
                  <classifier>natives-linux-amd64</classifier>
                  <outputDirectory>target/classes</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
