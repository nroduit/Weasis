<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <groupId>org.weasis.dicom.3d</groupId>
    <artifactId>weasis-dicom-3d</artifactId>
    <!--suppress MavenPropertyInParent -->
    <version>${revision}${changelist}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <groupId>org.weasis.thirdparty.org.jogamp</groupId>
  <artifactId>jogamp-native</artifactId>
  <name>JOGL plugins [${project.artifactId}]</name>
  <packaging>pom</packaging>

  <modules>
    <module>jogamp-linux-aarch64</module>
    <module>jogamp-linux-x86-64</module>
    <module>jogamp-macosx-aarch64</module>
    <module>jogamp-macosx-x86-64</module>
    <module>jogamp-windows-x86-64</module>
  </modules>

  <properties>
    <native.folder>changeMeInChildModule</native.folder>
    <native.files>changeMeInChildModule</native.files>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Plugin-Class>org.weasis.jogamp.NativeLoaderPlugin</Plugin-Class>
              <Plugin-Native-Folder>${native.folder}</Plugin-Native-Folder>
              <Plugin-Native-Files>${native.files}</Plugin-Native-Files>
              <Plugin-Id>${project.artifactId}</Plugin-Id>
              <Plugin-Version>${jogamp.version}</Plugin-Version>
              <Plugin-Provider>JogAmp Community</Plugin-Provider>
              <Plugin-Description>${project.name}</Plugin-Description>
              <Plugin-Dependencies>jogamp</Plugin-Dependencies>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.weasis.thirdparty.org.jogamp</groupId>
      <artifactId>jogamp</artifactId>
      <version>${jogamp.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
