#version 430

layout (local_size_x = 16, local_size_y = 16) in ;
layout (rgba32f, binding = 0) uniform image2D outputImage;
// Linear running average of the path tracer, written next to the display image it is tone-mapped into.
layout (rgba32f, binding = 1) uniform image2D accumImage;
// Averaged first-hit normal and depth guiding the denoise pass.
layout (rgba32f, binding = 2) uniform image2D featureImage;
layout (binding = 0) uniform sampler3D volTexture;
layout (binding = 1) uniform sampler2D colorMap;
layout (binding = 2) uniform sampler2D lightingMap;
layout (binding = 4) uniform usampler3D segTexture;
layout (binding = 5) uniform sampler2D segColorMap;
layout (binding = 6) uniform sampler2D envMap;
layout (binding = 7) uniform sampler2D historyMap;
layout (binding = 8) uniform sampler2D featureMap;

#include "voxelUniforms.glsl"

#include "voxelFunctions.glsl"

#include "vrFunctions.glsl"

#include "crosshairOverlay.glsl"

void main() {

    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    ivec2 imageDims = imageSize(outputImage);
    if (pixelCoords.x >= imageDims.x || pixelCoords.y >= imageDims.y) {
        return;
    }

    vec2 uv;
    uv.x = (float(pixelCoords.x * 2 - imageDims.x) / imageDims.x);
    uv.y = (float(pixelCoords.y * 2 - imageDims.y) / imageDims.y);

    vec4 pixelVal = vec4(0);
    if (renderingType == typePathTracing) {
        // The display image is produced by the denoise pass (denoise.comp) that follows.
        vec4 feature;
        imageStore(accumImage, pixelCoords, pathTrace(uv, pixelCoords, imageDims, feature));
        imageStore(featureImage, pixelCoords, feature);
        return;
    } else if (renderingType >= typeSlice) {
        pixelVal = slice(uv);
    } else {
        // Volume Rendering
        float tmin = 0.0;
        float tmax = 0.0;
        Ray ray = CreateCameraRay(uv);
        intersect(ray, tmin, tmax);
        if (tmax >= tmin) {
            if (renderingType == typeComposite) {
                pixelVal = rayCastingComposite(ray, tmin, tmax, uv);
            } else if (renderingType == typeMip) {
                pixelVal = rayCastingMip(ray, tmin, tmax, uv);
            } else if (renderingType == typeIsoSurface) {
                pixelVal = rayCastingIsoSurface(ray, tmin, tmax, uv);
            }
        }
    }
    imageStore(outputImage, pixelCoords, pixelVal);

    // ---- MPR crosshair overlay ----
    vec4 crosshairColor = computeCrosshairColor(pixelCoords, imageDims);
    if (crosshairColor.a >= 0.0) {
        imageStore(outputImage, pixelCoords, crosshairColor);
    }
}
