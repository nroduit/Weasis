                <artifactItem>
                  <groupId>org.weasis.dicom</groupId>
                  <artifactId>weasis-dicom-wave</artifactId>
                  <version>${app.version}</version>
                  <outputDirectory>${tmp.bundle.dir}</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>org.weasis.dicom</groupId>
                  <artifactId>weasis-dicom-wsi</artifactId>
                  <version>${app.version}</version>
