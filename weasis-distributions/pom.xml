                  <outputDirectory>${tmp.bundle.dir}</outputDirectory>
                </artifactItem>


                <!-- ===================================== -->
                <!-- Weasis 3D Modules -->
                <!-- ===================================== -->
                <artifactItem>
                  <groupId>org.weasis.dicom.3d</groupId>
                  <artifactId>weasis-dicom-viewer3d</artifactId>
