          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- The configuration files, filtered here rather than by the assembly, so the integrity
             list and the signature below cover the bytes the package ships. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-config</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${tmp.dir}/config</outputDirectory>
              <resources>
                <resource>
                  <directory>etc/config</directory>
                  <includes>
                    <include>*.json</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <!-- The sha256sum manifest of the launcher set, read by the bootstrap (weasis.launcher.sha256).
             Written after the jars are signed (process-resources) so the digests are those served. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <!-- The integrity list of base.json (S3 of the security spec): the SHA-256 and size of
                 every jar of the bundle and of the launcher set, after the jars are signed and
                 before compressXZ packs them (compile, main plugins run before the profile ones).
                 The launcher checks every download and every cached jar against it. -->
            <id>config-integrity</id>
            <phase>compile</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.weasis.launcher.integrity.IntegrityTool</mainClass>
              <includePluginDependencies>true</includePluginDependencies>
              <includeProjectDependencies>false</includeProjectDependencies>
              <arguments>
                <argument>digest</argument>
                <argument>${tmp.dir}/config/base.json</argument>
                <argument>${tmp.bundle.dir}</argument>
                <argument>${tmp.launcher.dir}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>launcher-manifest</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.weasis.bootstrap.tool.Sha256Sum</mainClass>
              <includePluginDependencies>true</includePluginDependencies>
              <includeProjectDependencies>false</includeProjectDependencies>
              <arguments>
                <argument>${tmp.launcher.dir}/launcher.sha256</argument>
                <argument>${tmp.launcher.dir}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.weasis.launcher</groupId>
            <artifactId>weasis-bootstrap</artifactId>
            <version>${app.version}</version>
          </dependency>
          <dependency>
            <groupId>org.weasis.launcher</groupId>
            <artifactId>weasis-launcher</artifactId>
            <version>${app.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>zip-resources</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <attach>false</attach>
              <finalName>resources</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <descriptors>
                <descriptor>src/assembly/zip-resources.xml</descriptor>
              </descriptors>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.weasis</groupId>
      <artifactId>weasis-i18n-dist</artifactId>
      <version>${i18n.version}</version>
      <type>zip</type>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- Signs base.json with the release key (S3): mvn ... -Dweasis.release.key=/path/release.key
           writes base.json.sig next to it, which the launcher verifies with the public keys of
           release-keys.json; without the key the package reaches the digest level only. -->
      <id>sign-config</id>
      <activation>
        <property>
          <name>weasis.release.key</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>config-sign</id>
                <phase>compile</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>org.weasis.launcher.integrity.IntegrityTool</mainClass>
                  <includePluginDependencies>true</includePluginDependencies>
                  <includeProjectDependencies>false</includeProjectDependencies>
                  <arguments>
                    <argument>sign</argument>
                    <argument>${tmp.dir}/config/base.json</argument>
                    <argument>${weasis.release.key}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
            <dependencies>
              <dependency>
                <groupId>org.weasis.launcher</groupId>
                <artifactId>weasis-launcher</artifactId>
                <version>${app.version}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>compressXZ</id>
      <properties>
        <xz.ext>.xz</xz.ext>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.weasis.maven</groupId>
            <artifactId>build-xz-plugin</artifactId>
            <version>2.0.0</version>
            <executions>
              <execution>
                <id>xz</id>
                <phase>compile</phase>
                <goals>
                  <goal>packFiles</goal>
                </goals>
                <configuration>
                  <archiveDirectory>${tmp.bundle.dir}</archiveDirectory>
                  <includes>
                    <include>**/*.jar</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>purgeI18nPackage</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>purge-local-dependencies</id>
                <phase>process-sources</phase>
                <goals>
                  <goal>purge-local-repository</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>org.weasis:weasis-i18n-dist</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>jar.signer</id>
      <activation>
        <!-- Use your own certificate either: mvn package -Djarsigner.alias="alias" -Djarsigner.storepass="storepass" -Djarsigner.keystore="/etc/cert_keystore" or : add properties in setting.xml (<jarsigner.alias>alias</jarsigner.alias>) -->
        <property>
          <name>jarsigner.alias</name>
        </property>
      </activation>

      <properties>
        <jarsigner.include.pattern>**/*.jar</jarsigner.include.pattern>
        <!-- if only root "jar" files should be processed, those referenced for download by JavaWebStart, use the following pattern instead -->
        <!-- <jarsigner.include.pattern>*.jar</jarsigner.include.pattern> -->
      </properties>

      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jarsigner-plugin</artifactId>
            <!-- Uncomment and provide proxy server setting when it is necessary to reach time stamping server from corporate network -->
            <!--<configuration> -->
            <!--<arguments> -->
            <!--<argument>-J-Dhttp.proxyHost=</argument> -->
            <!--<argument>-J-Dhttp.proxyPort=</argument> -->
            <!--</arguments> -->
            <!--</configuration> -->
            <executions>
              <execution>
                <id>sign</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <removeExistingSignatures>true</removeExistingSignatures>
                  <archiveDirectory>${tmp.dir}</archiveDirectory>
                  <includes>
                    <include>${jarsigner.include.pattern}</include>
                  </includes>
                  <excludes>
                    <!-- exclude .original.jar files that will be excluded from final packaging -->
                    <exclude>bundle/*.original.jar</exclude>
                  </excludes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
